# Hippocrates.am — the only environment file for this repository.
# Copy to `.env` at the repository root. apps/web and apps/api read that one file.
# Do not add apps/web/.env or apps/api/.env.

# Web on 3000, NestJS on 4000. The browser uses NEXT_PUBLIC_API_URL.
# On Vercel set WEB_URL to the public https origin (e.g. https://hippocrates.am)
# so favicon/Open Graph share previews resolve to absolute URLs.
WEB_URL="http://localhost:3000"
API_PORT="4000"
API_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Local PostgreSQL only. Do not put a production URL here.
# DATABASE_URL — Nest runtime (PrismaPg). May be a pooled host in hosted environments.
# DIRECT_URL — Prisma CLI only (`apps/api/prisma.config.ts`: migrate / generate / validate).
# Non-pooled. On local Postgres they are the same. On Neon, drop "-pooler" from the host.
DATABASE_URL="postgresql://hippocrates:hippocrates@localhost:5432/hippocrates"
DIRECT_URL="postgresql://hippocrates:hippocrates@localhost:5432/hippocrates"
DATABASE_CONNECTION_LIMIT="10"
DATABASE_POOL_TIMEOUT="20"

# Server-only session settings.
SESSION_COOKIE_NAME="hippocrates_session"
SESSION_TTL_HOURS="12"

# Password reset mail. Leave empty until Resend is connected.
# Without both values, production refuses the letter. Local development writes the link to the API log.
RESEND_API_KEY=""
MAIL_FROM=""

# Optional local seed. Leave empty in this example.
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""
SEED_PASSWORD=""

# Cloudflare R2. Leave secrets empty here. Set them only in the root `.env`.
# R2_PUBLIC_URL is the public direct base URL (r2.dev or a custom domain).
R2_ACCOUNT_ID=""
R2_API_TOKEN=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_ENDPOINT=""
R2_BUCKET=""
R2_PUBLIC_URL=""
