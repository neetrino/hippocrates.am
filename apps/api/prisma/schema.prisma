generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  DOCTOR
  PATIENT
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
  COMPLETED
  EXPIRED
  NO_SHOW
}

enum ScheduleProposal {
  PATIENT
  STAFF
}

enum QuestionStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum VerificationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum AppointmentEventType {
  CREATED
  CONFIRMED
  CANCELLED
  RESCHEDULED
  EXPIRED
  COMPLETED
  NO_SHOW
}

enum AppointmentActorRole {
  PATIENT
  ADMIN
  DOCTOR
  SYSTEM
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  role         Role
  clinicId     String?
  phone             String?
  photoKey          String?
  emailVisitNotices Boolean   @default(true)
  emailVerifiedAt   DateTime?
  disabledAt        DateTime?
  createdAt         DateTime @default(now())
  clinic       Clinic?  @relation("ClinicStaff", fields: [clinicId], references: [id])
  ownedClinics Clinic[] @relation("ClinicOwner")
  sessions     Session[]
  doctorProfile DoctorProfile?
  patientAppointments Appointment[] @relation("PatientAppointments")
  notifications Notification[]
  questions    Question[]
  reviews      Review[]
  favorites      Favorite[]
  passwordResets     PasswordReset[]
  emailVerifications EmailVerification[]

  @@index([clinicId])
  @@index([displayName(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_displayName_trgm_idx")
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Clinic {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  address     String   @default("")
  phone       String   @default("")
  district    String   @default("")
  coverKey    String?
  logoKey     String?
  timeZone    String   @default("Asia/Yerevan")
  archivedAt          DateTime?
  published           Boolean            @default(true)
  verificationStatus  VerificationStatus @default(APPROVED)
  ownerId     String   @unique
  owner       User     @relation("ClinicOwner", fields: [ownerId], references: [id])
  staff       User[]   @relation("ClinicStaff")
  branches    Branch[]
  doctors     DoctorProfile[]
  offerings   ServiceOffering[]
  appointments Appointment[]
  reviews     Review[]
  questions   Question[]
  locales     ClinicLocale[]
  windows     ClinicWindow[]
  favorites   Favorite[]

  @@index([published, verificationStatus, name, id])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Clinic_name_trgm_idx")
}

model ClinicLocale {
  id          String @id @default(cuid())
  clinicId    String
  locale      String
  name        String @default("")
  district    String @default("")
  address     String @default("")
  description String @default("")
  clinic      Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, locale])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "ClinicLocale_name_trgm_idx")
}

model Branch {
  id       String @id @default(cuid())
  clinicId String
  name     String
  address  String @default("")
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId])
}

model DoctorProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  clinicId    String
  specialty   String
  bio         String   @default("")
  photoKey    String?
  published           Boolean            @default(true)
  verificationStatus  VerificationStatus @default(APPROVED)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  offerings   ServiceOffering[]
  windows     ScheduleWindow[]
  exceptions  ScheduleException[]
  appointments Appointment[]
  answers     Answer[]
  reviews     Review[]
  locales     DoctorLocale[]
  favorites   Favorite[]

  @@index([published, verificationStatus, specialty])
  @@index([clinicId])
}

model DoctorLocale {
  id        String @id @default(cuid())
  doctorId  String
  locale    String
  name      String @default("")
  specialty String @default("")
  bio       String @default("")
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, locale])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "DoctorLocale_name_trgm_idx")
}

model ServiceOffering {
  id              String  @id @default(cuid())
  clinicId        String
  doctorId        String
  name            String
  priceAmd        Int
  isEstimate      Boolean @default(false)
  durationMinutes Int
  published       Boolean @default(true)
  clinic          Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor          DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointments    Appointment[]

  @@index([clinicId])
  @@index([doctorId])
}

model ClinicWindow {
  id          String @id @default(cuid())
  clinicId    String
  weekday     Int
  startMinute Int
  endMinute   Int
  clinic      Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, weekday])
}

model ScheduleWindow {
  id           String @id @default(cuid())
  doctorId     String
  weekday      Int
  startMinute  Int
  endMinute    Int
  doctor       DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, weekday])
}

model ScheduleException {
  id        String   @id @default(cuid())
  doctorId  String
  startsAt  DateTime
  endsAt    DateTime
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, startsAt, endsAt])
}

model Appointment {
  id            String            @id @default(cuid())
  patientId     String?
  doctorId      String
  clinicId      String
  offeringId    String
  startsAt      DateTime
  endsAt        DateTime
  status        AppointmentStatus @default(REQUESTED)
  proposedBy    ScheduleProposal  @default(PATIENT)
  cancelReason  String?
  priceAmd      Int
  isEstimate    Boolean
  idempotencyKey String?
  guestName     String?
  guestPhone    String?
  patient       User?             @relation("PatientAppointments", fields: [patientId], references: [id])
  doctor        DoctorProfile     @relation(fields: [doctorId], references: [id])
  clinic        Clinic            @relation(fields: [clinicId], references: [id])
  offering      ServiceOffering   @relation(fields: [offeringId], references: [id])
  notifications Notification[]
  events        AppointmentEvent[]
  review        Review?

  @@unique([patientId, idempotencyKey])
  @@index([clinicId, patientId])
  @@index([patientId, startsAt])
  @@index([doctorId, startsAt])
  @@index([clinicId, startsAt])
  @@index([status, startsAt])
}

model AppointmentEvent {
  id            String                @id @default(cuid())
  appointmentId String
  type          AppointmentEventType
  fromStatus    AppointmentStatus?
  toStatus      AppointmentStatus
  actorUserId   String?
  actorRole     AppointmentActorRole
  reason        String?
  fromStartsAt  DateTime?
  toStartsAt    DateTime?
  createdAt     DateTime              @default(now())
  appointment   Appointment           @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
}

model Notification {
  id            String   @id @default(cuid())
  userId        String
  appointmentId String?
  body          String
  detail        String?
  dedupeKey     String?  @unique
  readAt        DateTime?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  mail          NoticeMail?

  @@index([userId, createdAt])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([appointmentId])
  @@index([userId], map: "Notification_unread_idx", where: raw("(\"readAt\" IS NULL)"))
}

enum NoticeMailStatus {
  PENDING
  SENT
  SKIPPED
  FAILED
}

model NoticeMail {
  id             String           @id @default(cuid())
  notificationId String           @unique
  status         NoticeMailStatus @default(PENDING)
  attempts       Int              @default(0)
  sentAt         DateTime?
  createdAt      DateTime         @default(now())
  notification   Notification     @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model Question {
  id        String         @id @default(cuid())
  authorId  String
  clinicId  String?
  title     String
  body      String
  category  String         @default("Ընդհանուր")
  status    QuestionStatus @default(PENDING)
  createdAt DateTime       @default(now())
  author    User           @relation(fields: [authorId], references: [id])
  clinic    Clinic?        @relation(fields: [clinicId], references: [id])
  answers   Answer[]

  @@index([status, createdAt])
  @@index([clinicId])
}

model Answer {
  id         String   @id @default(cuid())
  questionId String
  doctorId   String
  body       String
  published  Boolean  @default(false)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  doctor     DoctorProfile @relation(fields: [doctorId], references: [id])

  @@index([questionId, published])
  @@index([doctorId])
}

model Review {
  id            String   @id @default(cuid())
  appointmentId String   @unique
  patientId     String
  clinicId      String
  doctorId      String
  rating        Int
  body          String
  reply         String?
  createdAt     DateTime @default(now())
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  patient       User     @relation(fields: [patientId], references: [id])
  clinic        Clinic   @relation(fields: [clinicId], references: [id])
  doctor        DoctorProfile @relation(fields: [doctorId], references: [id])
  locales       ReviewLocale[]

  @@index([clinicId, createdAt])
  @@index([doctorId])
}

model Favorite {
  id        String         @id @default(cuid())
  userId    String
  clinicId  String?
  doctorId  String?
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic    Clinic?        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor    DoctorProfile? @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([userId, clinicId])
  @@unique([userId, doctorId])
  @@index([userId])
}

model EmailVerification {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RateLimitBucket {
  key         String   @id
  windowStart DateTime
  count       Int      @default(1)
  expiresAt   DateTime

  @@index([expiresAt])
}

/// One row. Super Admin changes the platform booking and registration rules.
model PlatformSetting {
  id                          String   @id
  patientRegistrationEnabled  Boolean  @default(true)
  bookingEnabled              Boolean  @default(true)
  maxBookingDays              Int      @default(60)
  minNoticeMinutes            Int      @default(120)
  cancelDeadlineMinutes       Int      @default(1440)
  rescheduleDeadlineMinutes   Int      @default(1440)
  updatedAt                   DateTime @updatedAt
}

model ReviewLocale {
  id       String @id @default(cuid())
  reviewId String
  locale   String
  body     String @default("")
  reply    String @default("")
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, locale])
}
