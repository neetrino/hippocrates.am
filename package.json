{
  "name": "hippocrates",
  "private": true,
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @hippocrates/web --filter @hippocrates/api dev",
    "lint": "pnpm -r --if-present lint",
    "codegen": "pnpm --filter @hippocrates/api db:generate",
    "typecheck": "pnpm codegen && pnpm -r --if-present typecheck",
    "test": "pnpm codegen && pnpm -r --if-present test",
    "build": "pnpm codegen && pnpm -r --if-present build",
    "ci:guard": "node scripts/ci/repo-guard.mjs",
    "db:migrate": "pnpm --filter @hippocrates/api db:migrate",
    "db:seed": "pnpm --filter @hippocrates/api db:seed",
    "db:validate": "pnpm --filter @hippocrates/api db:validate"
  },
  "devDependencies": {
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "typescript-eslint": "8.71.2"
  }
}
