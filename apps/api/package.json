{
  "name": "@hippocrates/api",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- node --watch -r ts-node/register src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "dotenv -e ../../.env -- node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "jest --runInBand",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "dotenv -e ../../.env -- ts-node src/seed.ts",
    "db:generate": "dotenv -e ../../.env -- prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.44.0",
    "cookie-parser": "1.4.7",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.9",
    "@types/express": "^5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.5.2",
    "@types/pg": "8.15.5",
    "dotenv-cli": "10.0.0",
    "eslint": "9.39.4",
    "jest": "30.1.3",
    "prisma": "7.10.0",
    "ts-jest": "29.4.4",
    "ts-node": "10.9.2",
    "typescript": "5.9.2"
  }
}
